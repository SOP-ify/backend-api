# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"
MONGODB_DATABASE="sopifydb"

# ── JWT / Security ────────────────────────────────────────────────────────────
# generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="ganti-dengan-secret-key-minimal-32-karakter"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── CORS ──────────────────────────────────────────────────────────────────────
# untuk production, ganti * dengan origin spesifik
ALLOWED_ORIGINS=["*"]

# ── Machine Learning ──────────────────────────────────────────────────────────
ML_MODEL_ID="google/gemma-2-2b-it"
ML_ADAPTER_ID="iqbalreza/sopify-gemma2-2b-umkm-lora"
HUGGINGFACE_TOKEN="hf_xxxxxxxxxxxxxxxxxxxx"
WHISPER_MODEL_SIZE="medium"

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET_NAME="sopify-bucket"
# service account key (paste seluruh JSON sebagai 1 baris string)
GCS_CREDENTIALS_JSON='{"type":"service_account","project_id":"sop-ify","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@sop-ify.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
